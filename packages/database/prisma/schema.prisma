generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  provider     AuthProvider  @default(EMAIL)
  providerId   String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assets       Asset[]
  transactions Transaction[]
}

model Asset {
  id                String               @id @default(uuid())
  userId            String
  type              AssetType
  name              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  fdDetails         FixedDepositDetails?
  investmentDetails InvestmentDetails?
  loanDetails       LoanDetails?
  transactions      Transaction[]
}

model LoanDetails {
  id              String     @id @default(uuid())
  assetId         String     @unique
  principalAmount Float
  interestRate    Float
  tenureMonths    Int
  startDate       DateTime
  status          LoanStatus @default(APPLIED)
  emiAmount       Float?
  asset           Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model FixedDepositDetails {
  id              String   @id @default(uuid())
  assetId         String   @unique
  principalAmount Float
  interestRate    Float
  startDate       DateTime
  maturityDate    DateTime
  maturityAmount  Float?
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model InvestmentDetails {
  id              String @id @default(uuid())
  assetId         String @unique
  symbol          String
  averageBuyPrice Float  @default(0)
  quantity        Float  @default(0)
  asset           Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String          @id @default(uuid())
  userId       String
  assetId      String?
  type         TransactionType
  amount       Float
  pricePerUnit Float?
  quantity     Float?
  date         DateTime        @default(now())
  notes        String?
  asset        Asset?          @relation(fields: [assetId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum AssetType {
  LOAN
  FIXED_DEPOSIT
  STOCK
  MUTUAL_FUND
}

enum LoanStatus {
  APPLIED
  APPROVED
  DISBURSED
  REJECTED
  CLOSED
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT_FD
  LOAN_PAYMENT
  DIVIDEND
  INTEREST_CREDIT
}
